# Local Airflow metadata database credentials. Use unique local values.
AIRFLOW_DB_USER=airflow_local
AIRFLOW_DB_PASSWORD=replace-with-a-local-password

# Airflow API signing key. Generate a random value for your local environment.
AIRFLOW_API_SECRET_KEY=replace-with-a-random-secret-key

# Shared JWT key used by the scheduler and API server for task execution tokens.
AIRFLOW_JWT_SECRET=replace-with-a-different-random-secret-key
