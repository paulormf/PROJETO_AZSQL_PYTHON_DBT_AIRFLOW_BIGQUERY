# Credenciais locais do banco de metadados do Airflow. Use valores exclusivos neste ambiente.
AIRFLOW_DB_USER=airflow_local
AIRFLOW_DB_PASSWORD=replace-with-a-local-password

# Chave de assinatura da API do Airflow. Gere um valor aleatório para seu ambiente local.
AIRFLOW_API_SECRET_KEY=replace-with-a-random-secret-key

# Chave JWT compartilhada pelo scheduler e pelo servidor da API para os tokens de execução das tarefas.
AIRFLOW_JWT_SECRET=replace-with-a-different-random-secret-key
