# Copy this file to .env and fill it locally. Never commit .env.
AZURE_SQL_SERVER=treinamento.database.windows.net
AZURE_SQL_DATABASE=free-sql-db-5098886
AZURE_SQL_USERNAME=your-read-only-user
AZURE_SQL_PASSWORD=replace-locally
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no
AZURE_SQL_CONNECTION_TIMEOUT=30

# GCP settings. Authentication uses local Application Default Credentials.
GCS_BUCKET=your-gcs-bucket
GCS_PREFIX=raw
EXPORT_CHUNK_ROWS=5000
GCP_PROJECT_ID=your-gcp-project-id
BQ_STAGING_DATASET=PROJECT_1_STAGING
BQ_BRONZE_DATASET=PROJECT_1_BRONZE
BQ_LOCATION=us-central1
BQ_STAGING_TABLE_TTL_DAYS=7
